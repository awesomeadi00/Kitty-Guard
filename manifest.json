{
    "manifest_version": 3,
    "name": "Kitty Guard",
    "version": "1.0",
    "description": "A privacy extension where your friendly neighbourhood cat blocks your trackers and protects your fingerprint",
    "icons": {
        "16": "images/extension_icon.png",
        "48": "images/extension_icon.png",
        "128": "images/extension_icon.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/extension_icon.png",
            "48": "images/extension_icon.png",
            "128": "images/extension_icon.png"
        }
    },
    "permissions": [
        "declarativeNetRequest",
        "declarativeNetRequestFeedback",
        "webRequest",
        "storage",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content-script.js"
            ],
            "run_at": "document_start"
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    }
}